# Multigolf backend configuration.
# Copy this file to .env and adjust the values for your deployment.
# This file lives outside the public web root and is never served.

# production | development (development exposes error details)
APP_ENV=production

# Persistent data. Keep these outside the public document root.
# Defaults to <backend>/data when unset.
#DATA_DIR=/var/www/multigolf-backend/data
#DATABASE_PATH=/var/www/multigolf-backend/data/multigolf.sqlite

# Used for the visit counters and the /get_visit_count.php response.
# Set this to the URL the frontend is served from.
SITE_URL=https://multi.golf

# Comma-separated list of allowed browser origins, or * for any origin.
# Signaling uses no cookies, so * is safe but you may want to restrict it.
ALLOWED_ORIGINS=*

# How long an idle signaling pool and its transient signals are kept (seconds).
POOL_TTL_SECONDS=1800
SIGNAL_TTL_SECONDS=600
MAX_SIGNALS_PER_POOL=300
MAX_SIGNAL_BYTES=262144

# Set to true when running behind a trusted reverse proxy (Cloudflare, nginx).
TRUST_PROXY_HEADERS=false

# Form handling. Submissions are stored in SQLite by default. Set
# STORE_SUBMISSIONS=false if you only want to receive them by email.
STORE_SUBMISSIONS=true
SUBMISSION_RETENTION_DAYS=90

# mail | log | none. "log" writes to data/mail.log (useful for development).
MAIL_TRANSPORT=mail
MAIL_FROM=multigolf@example.com
CONTACT_RECIPIENT=you@example.com
FEEDBACK_RECIPIENT=you@example.com
