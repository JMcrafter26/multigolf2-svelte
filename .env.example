# Copy this file to .env and adjust the values for your deployment.
# PUBLIC_* variables are inlined into the static build at build time.

# Base URL of the Multigolf PHP API (see backend/README.md).
# Local development: http://127.0.0.1:8787/api
PUBLIC_API_BASE_URL=https://www.noel-friedrich.de/multigolf2/api

# Canonical public URL of this deployment. Used by the developer stats page and
# should match SITE_URL in backend/.env.
PUBLIC_SITE_URL=https://multi.golf

# Endpoint returning visit counts as [{ "url": "...", "visits": 123 }] for the
# developer stats page. When using the bundled backend, set this to
# <PUBLIC_API_BASE_URL>/get_visit_count.php.
PUBLIC_STATS_API_URL=https://www.noel-friedrich.de/terminal/api/get_visit_count.php

# Optional TURN credentials endpoint. Leave empty to use only the built-in
# STUN/TURN fallbacks.
PUBLIC_TURN_CREDENTIALS_URL=https://multigolf2.metered.live/api/v1/turn/credentials?apiKey=17135e6b2d8ea014e96ceffe0543a04c49af
